# ============================================
# CLOUDTASK PRO - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and update values
# .env is ignored by git (secrets stay local)
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL Database Password
# Required: Yes
DB_PASSWORD=your_strong_password_here

# ============================================
# JWT AUTHENTICATION
# ============================================
# JWT Secret Key for signing tokens (min 32 characters)
# Generate: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# ============================================
# GRAFANA MONITORING
# ============================================
# Grafana Admin Password
GRAFANA_PASSWORD=your_grafana_password_here

# ============================================
# SPRING BOOT APPLICATION
# ============================================
# Active Spring Profile (dev, docker, prod)
SPRING_PROFILES_ACTIVE=prod

# Application Port
SERVER_PORT=8080

# ============================================
# AWS CONFIGURATION (For Production)
# ============================================
# AWS Region
AWS_REGION=us-east-1

# AWS Access Key ID (for ECR/S3 access)
# AWS_ACCESS_KEY_ID=AKIA...

# AWS Secret Access Key
# AWS_SECRET_ACCESS_KEY=...

# ============================================
# EC2 DEPLOYMENT (For CI/CD)
# ============================================
# EC2 Instance Public IP
# EC2_HOST=54.123.45.67

# EC2 SSH Username (ubuntu, ec2-user, admin)
# EC2_USER=ubuntu

# EC2 SSH Private Key (base64 encoded)
# Generate: cat ~/.ssh/id_rsa | base64
# EC2_SSH_KEY=LS0tLS1CRUdJTiBSU0EgUFJJVkFURS...

# ============================================
# DOCKER HUB (For CI/CD)
# ============================================
# Docker Hub Username
# DOCKER_USERNAME=your-username

# Docker Hub Password or Access Token
# DOCKER_PASSWORD=your-password-or-token

# ============================================
# NOTIFICATIONS (Optional)
# ============================================
# Slack Webhook URL for deployment notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ============================================
# MONITORING
# ============================================
# Prometheus Retention Period (30d, 60d, 90d)
PROMETHEUS_RETENTION=30d

# ============================================
# SECURITY
# ============================================
# CORS Allowed Origins (*, http://localhost:3000, https://yourdomain.com)
# CORS_ALLOWED_ORIGINS=*

# Rate Limiting (requests per minute per IP)
# RATE_LIMIT=100
